@using VideoAtlas.Application
@model LanguageCatalogView
@{ var selected = Context.Request.Query["language"].ToString(); if (string.IsNullOrWhiteSpace(selected)) { selected = Model.Languages.First(x => x.IsDefault).Code; } var current = Model.Languages.First(x => x.Code == selected)!; ViewData["Title"] = "Diller ve içerikler"; }
<header class="topbar"><span>Yönetim <span class="slash">/</span> <strong>Diller ve içerikler</strong></span><a href="/admin/providers">AI sağlayıcıları →</a></header>
<div class="workspace-content provider-page">
  <div class="page-heading"><div><span class="eyebrow">ÇOK DİLLİ KATALOG</span><h1>Diller ve içerikler<span class="accent-dot">.</span></h1><p class="muted">Arayüz metinlerini, tanımları ve analiz dillerini tek bir katalogdan yönetin.</p></div></div>
  @if (TempData["LocalizationMessage"] is string message) { <div class="notice" role="status">@message</div> }
  <section class="provider-panel"><h2>Dil paketi</h2><p class="muted">Dil kodu örneği: <code>tr</code>, <code>en</code>, <code>de</code>. Varsayılan dil, ilk kez gelen kullanıcılar için kullanılır.</p>
    <form action="/admin/localization/language" method="post" class="language-config-grid">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@current.Version" /><div><label>Kod</label><input class="form-control" name="Code" value="@current.Code" required /></div><div><label>Görünen ad</label><input class="form-control" name="Name" value="@current.Name" required /></div><div class="language-toggles"><label class="check-label"><input name="Enabled" type="checkbox" value="true" checked="@current.IsEnabled" /> Kullanıma açık</label><label class="check-label"><input name="IsDefault" type="checkbox" value="true" checked="@current.IsDefault" /> Varsayılan</label></div><div class="language-save"><button class="btn btn-primary">Dil paketini kaydet</button></div></form>
    <div class="language-chip-list">@foreach (var lang in Model.Languages) { <a href="/admin/localization?language=@lang.Code" class="btn btn-outline-secondary @(lang.Code == selected ? "active" : "")">@lang.Name <small>@lang.Code · @lang.TranslationCount/@Model.Translations.Count</small></a> }</div>
  </section>
  <section class="provider-panel"><h2>Otomasyon ve aktarım</h2><p class="muted">AI yalnızca boş çevirileri taslak olarak doldurur; mevcut insan çevirilerinin üzerine yazmaz.</p><div class="language-action-bar"><form action="/admin/localization/fill/@selected" method="post">@Html.AntiForgeryToken()<button class="btn btn-primary">AI ile eksikleri doldur</button></form><a class="btn btn-outline-secondary" href="/admin/localization/export/@selected">@selected JSON indir</a></div>
    <details class="context-fields"><summary>JSON dil paketi içe aktar</summary><form action="/admin/localization/import" method="post" class="stack-form">@Html.AntiForgeryToken()<textarea class="form-control" name="Json" rows="8" required placeholder='{"code":"de","name":"Deutsch","enabled":true,"translations":{"nav.library":"Videobibliothek"}}'></textarea><button class="btn btn-outline-secondary">JSON'u içe aktar</button></form></details>
  </section>
  <section class="provider-panel"><h2>@current.Name metinleri</h2><p class="muted">Her kayıt, uygulamadaki bir içerik/tanım anahtarına karşılık gelir. Kaydettiğiniz değer anında yeni isteklerde kullanılır.</p><div class="translation-list">@foreach (var item in Model.Translations) { <form action="/admin/localization/translation" method="post" class="translation-row">@Html.AntiForgeryToken()<input type="hidden" name="Language" value="@selected" /><input type="hidden" name="Key" value="@item.Key" /><input type="hidden" name="Version" value="@item.Version" /><label><code>@item.Key</code><small>@item.DefaultText</small></label><input class="form-control" name="Text" value="@item.Text" placeholder="Çeviri girin" required /><button class="btn btn-outline-secondary">Kaydet</button></form> }</div></section>
</div>
