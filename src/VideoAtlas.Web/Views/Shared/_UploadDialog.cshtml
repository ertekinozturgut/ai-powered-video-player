@inject VideoAtlas.Application.ILocalizationAdministration Catalog
@{ var uploadOwner = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; var uploadLanguage = await Catalog.ResolveLanguageAsync(uploadOwner, Context.Request.Cookies["VideoAtlas.Language"], Context.RequestAborted); var uploadLanguages = await Catalog.EnabledAsync(Context.RequestAborted); var u = new Dictionary<string, string>(); foreach (var key in new[] { "upload.eyebrow", "upload.mediaTitle", "upload.mediaFile", "upload.fileHelp", "upload.videoTitle", "upload.terms", "upload.instructions", "upload.language", "upload.submit", "common.close" }) u[key] = await Catalog.TextAsync(key, uploadLanguage, Context.RequestAborted); }
<dialog id="upload-dialog" class="app-dialog">
    <div class="dialog-heading"><div><span class="eyebrow">@u["upload.eyebrow"]</span><h2>@u["upload.mediaTitle"]</h2></div><button class="icon-button" data-close aria-label="@u["common.close"]">×</button></div>
    <form id="upload-form" class="stack-form">
        <label id="drop-zone" class="drop-zone" for="video-file"><span class="empty-icon">↑</span><strong>@u["upload.mediaFile"]</strong><span>@u["upload.fileHelp"]</span><small>MP4, MOV, WebM, MP3, WAV, M4A, AAC, FLAC, OGG · 512 MiB · 2 saat</small></label>
        <input id="video-file" name="file" type="file" accept="video/mp4,video/quicktime,video/webm,video/x-matroska,audio/mpeg,audio/wav,audio/x-wav,audio/mp4,audio/aac,audio/flac,audio/ogg,audio/opus,.mp3,.wav,.m4a,.aac,.flac,.ogg,.opus,.aiff,.wma" required class="form-control" />
        <div><label for="video-title">@u["upload.videoTitle"]</label><input id="video-title" name="title" class="form-control" maxlength="180" required placeholder="Örnek video başlığı" /></div>
        <fieldset class="speaker-analysis-options">
            <legend>Konuşmacı analizi</legend>
            <label class="check-label"><input id="upload-diarization" name="speakerDiarization" type="checkbox" value="true" /><span>Konuşmacıları ayırarak metne çevir</span></label>
            <div id="upload-speaker-count-field" hidden><label for="upload-speaker-count">Konuşmacı sayısı (isteğe bağlı)</label><input id="upload-speaker-count" name="speakerCount" type="number" min="2" max="32" placeholder="Otomatik tespit" class="form-control" disabled /><small class="muted">Boş bırakırsanız sistem ses benzerliği, frekans ve stereo kanal ayrımından konuşmacı sayısını otomatik tahmin eder. İsterseniz 2–32 arasında sabitleyebilirsiniz.</small></div>
            <small class="muted">Konuşmacı ayrımı etkin STT sağlayıcısı tarafından desteklenmelidir ve ek ücret doğurabilir.</small>
        </fieldset>
        <details class="context-fields"><summary>Videoya özel terimler ve analiz yönergeleri (isteğe bağlı)</summary>
            <label for="upload-terms">@u["upload.terms"]</label><textarea id="upload-terms" name="terms" class="form-control" rows="3" maxlength="32000" placeholder="TERİM_1 | Örnek açıklama"></textarea>
            <small class="muted">En fazla 50 terim. Terim 100, açıklama 500 karakter; her terim ayrı satırda.</small>
            <label for="upload-instructions">@u["upload.instructions"]</label><textarea id="upload-instructions" name="analysisInstructions" class="form-control" rows="3" maxlength="4000" placeholder="Örnek analiz yönergesi"></textarea>
            <small class="muted">Yönergeler ve sözlük yardımcı bağlamdır; videoda söylenmiş bilgi sayılmaz. Etkin AI sağlayıcısına gönderilir.</small>
            <label for="upload-language">@u["upload.language"]</label><select id="upload-language" name="analysisLanguage" class="form-select">@foreach (var item in uploadLanguages) { <option value="@item.Code" selected="@(item.Code == uploadLanguage)">@item.Name</option> }</select>
            <small class="muted">Konu başlıkları, kalite önerileri ve AI yanıtları seçtiğiniz dilde üretilir.</small>
        </details>
        <label class="check-label"><input name="consent" type="checkbox" value="true" required /><span>Bu videoyu işleme hakkına sahibim. Video/ses/metnin işlenmesini ve etkin STT, dil modeli ve indeksleme sağlayıcılarına aktarılmasını <a href="/privacy" target="_blank" rel="noopener">veri işleme açıklaması</a> kapsamında onaylıyorum.</span></label>
        <label class="check-label"><input name="fullReview" type="checkbox" value="true" checked /> Tüm metni AI ile bağlam ve dil bilgisi açısından tara; yalnızca güvenli düzeltmeleri otomatik uygula (ek API ücreti doğurabilir).</label>
        <div id="upload-error" class="form-error" role="alert"></div>
        <progress id="upload-progress" max="100" value="0" hidden aria-label="Yükleme ilerlemesi"></progress>
        <button id="upload-submit" class="btn btn-primary btn-lg" type="submit">@u["upload.submit"]</button>
        <small class="muted">Yükleme tamamlanınca analiz arka planda devam eder.</small>
    </form>
</dialog>
