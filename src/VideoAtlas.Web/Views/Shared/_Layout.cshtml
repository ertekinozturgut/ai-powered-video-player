@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject VideoAtlas.Application.ILocalizationAdministration Catalog
@{ var embedded = ViewData["Embedded"] as bool? == true; var owner = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; var language = await Catalog.ResolveLanguageAsync(owner, Context.Request.Cookies["VideoAtlas.Language"], Context.RequestAborted); var languages = await Catalog.EnabledAsync(Context.RequestAborted); var ui = new Dictionary<string, string>(); foreach (var key in new[] { "nav.workspace", "nav.library", "nav.privacy", "nav.operations", "nav.providers", "nav.account", "nav.password", "nav.logout", "admin.localization" }) ui[key] = await Catalog.TextAsync(key, language, Context.RequestAborted); var path = Context.Request.Path; var showMenuLabel = language == "en" ? "Show menu" : "Menüyü göster"; var hideMenuLabel = language == "en" ? "Hide menu" : "Menüyü gizle"; }
<!DOCTYPE html>
<html lang="@(language ?? languages.FirstOrDefault(x => x.IsDefault)?.Code ?? "tr")" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06070b" />
    @if (!embedded || ViewData["PrivateShare"] as bool? == true) { <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" /> }
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] · VideoAtlas</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="/css/readability.css" asp-append-version="true" />
</head>
<body class="@(embedded ? "embed-layout" : "app-layout")">
<a class="skip-link" href="#main">İçeriğe geç</a>
@if (!embedded && User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar" id="app-sidebar">
        <a href="/" class="brand"><span class="brand-mark" aria-hidden="true"></span> Video<span>Atlas</span></a>
        <div class="workspace-label">@ui["nav.workspace"]</div>
        <nav aria-label="Ana gezinme">
            <a href="/" aria-label="@ui["nav.library"]" class="nav-item @(path == "/" || path.StartsWithSegments("/videos") ? "active" : "")"><span aria-hidden="true">▦</span><span class="nav-label">@ui["nav.library"]</span></a>
            <a href="/privacy" aria-label="@ui["nav.privacy"]" class="nav-item @(path.StartsWithSegments("/privacy") ? "active" : "")"><span aria-hidden="true">◇</span><span class="nav-label">@ui["nav.privacy"]</span></a>
            @if (User.IsInRole("Administrator"))
            {
                <a href="/admin/operations" class="nav-item @(path.StartsWithSegments("/admin/operations") ? "active" : "")"><span aria-hidden="true">◷</span><span class="nav-label">@ui["nav.operations"]</span></a>
                <a href="/admin/providers" class="nav-item @(path.StartsWithSegments("/admin/providers") ? "active" : "")" aria-label="AI sağlayıcı yönetimi"><span aria-hidden="true">⚙</span><span class="nav-label">@ui["nav.providers"]</span></a>
                <a href="/admin/localization" class="nav-item @(path.StartsWithSegments("/admin/localization") ? "active" : "")"><span aria-hidden="true">◎</span><span class="nav-label">@ui["admin.localization"]</span></a>
            }
        </nav>
        <div class="sidebar-note"><img src="/images/atlas-orb.svg" alt="" width="88" height="88" /><span class="eyebrow">DAHA FAZLASINI KEŞFEDİN</span><strong>Her an, yeni bir fikir.</strong><p>Videolarınızla konuşun.<br />Bilgiye doğrudan ulaşın.</p></div>
        <a href="/account/profile" class="account-block"><span class="avatar">V</span><div><strong>@(language == "en" ? "My account" : "Hesabım")</strong><small>@User.Identity.Name</small></div></a>
        <form action="/language/select" method="post" class="language-switcher" data-language-form>@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><select name="code" aria-label="Arayüz dili" data-language-select>@foreach (var item in languages) { <option value="@item.Code" selected="@(item.Code == (language ?? languages.FirstOrDefault(x => x.IsDefault)?.Code))">@item.Name</option> }</select></form>
        <form action="/account/logout" method="post">@Html.AntiForgeryToken()<button class="signout" type="submit">@ui["nav.logout"] <span class="arrow-out" aria-hidden="true"></span></button></form>
    </aside>
    <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-controls="app-sidebar" aria-expanded="true" aria-label="@hideMenuLabel" title="@hideMenuLabel" data-show-label="@showMenuLabel" data-hide-label="@hideMenuLabel"><span class="sidebar-toggle-icon" aria-hidden="true"></span></button>
}
<main id="main" class="main-shell">@RenderBody()</main>
<div id="toast" class="toast-message" role="status" aria-live="polite" hidden></div>
<script type="module" src="/js/common.js" asp-append-version="true"></script>
<script type="module" src="/js/localize.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
