@model ApiAdminView
@inject TimeProvider Clock
@{ ViewData["Title"] = "API yönetimi"; }
<header class="topbar"><a href="/">← Çalışma alanı</a><span class="security-pill">Yönetici</span></header>
<div class="workspace-content operations-admin-page">
  <div class="page-heading admin-heading"><div><span class="eyebrow">THIRD-PARTY API</span><h1>API yönetimi<span class="accent-dot">.</span></h1><p class="muted">Kimlik bilgileri, kullanıcı eşleşmeleri ve güvenli istek denetim kayıtları.</p></div><a class="btn btn-outline-secondary" href="/api/v1">v1 keşif</a></div>
  @if (TempData["ApiAdminMessage"] is string apiMessage) { <div class="notice">@apiMessage</div> }
  @if (!string.IsNullOrWhiteSpace(Model.CreatedSecret)) { <div class="notice"><strong>Bu gizli anahtar yalnızca bir kez gösterilir:</strong><br/><code style="overflow-wrap:anywhere">@Model.CreatedSecret</code></div> }
  <div class="stats-grid"><article class="stat-card"><span>Aktif anahtar</span><strong>@Model.ActiveCredentials</strong></article><article class="stat-card"><span>Bugünkü istek</span><strong>@Model.RequestsToday</strong></article><article class="stat-card"><span>Bugünkü hata</span><strong>@Model.FailedToday</strong></article></div>
  <section class="provider-panel mt-4"><h2>Kullanıcıya API kimlik bilgisi ata</h2><form action="/admin/api/credentials" method="post" class="stack-form">@Html.AntiForgeryToken()<div class="admin-filter-form"><div><label for="owner">Kullanıcı</label><select id="owner" name="OwnerId" class="form-select" required>@foreach (var user in Model.Users) { <option value="@user.Id">@user.Email</option> }</select></div><div><label for="credential-name">Ad</label><input id="credential-name" name="Name" class="form-control" value="Integration" maxlength="80" required/></div><div><label for="credential-expiry">Geçerlilik</label><select id="credential-expiry" name="ExpiresInDays" class="form-select"><option value="30">30 gün</option><option value="90" selected>90 gün</option><option value="365">1 yıl</option><option value="0">Süresiz</option></select></div></div><div><label><input name="Read" value="true" type="checkbox" checked/> Okuma</label> <label><input name="Write" value="true" type="checkbox" checked/> Yazma</label> <label><input name="Delete" value="true" type="checkbox"/> Silme</label></div><button class="btn btn-primary" type="submit">Kullanıcıya anahtar oluştur</button></form></section>
  <section class="provider-panel mt-4"><h2>Kullanıcı API kimlik bilgileri</h2><div class="table-responsive"><table class="table"><thead><tr><th>Kullanıcı</th><th>Ad / önek</th><th>Kapsam</th><th>Durum</th><th>Son kullanım</th><th></th></tr></thead><tbody>@foreach (var item in Model.Credentials) { <tr><td>@item.OwnerEmail</td><td><strong>@item.Name</strong><br/><code>vat_@item.Prefix.…</code></td><td><small>@item.Scopes</small></td><td>@(item.RevokedAt != null ? "İptal" : item.ExpiresAt < Clock.GetUtcNow() ? "Süresi doldu" : "Aktif")</td><td>@(item.LastUsedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td><td>@if (item.RevokedAt is null) { <form action="/admin/api/credentials/@item.Id/revoke" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" type="submit">İptal et</button></form> }</td></tr> }</tbody></table></div></section>
  <section class="provider-panel mt-4"><h2>Son API istekleri</h2><div class="table-responsive"><table class="table"><thead><tr><th>Zaman</th><th>Anahtar</th><th>İstek</th><th>HTTP</th><th>Süre</th><th>Video / iz</th></tr></thead><tbody>@foreach (var log in Model.Logs) { <tr><td>@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td><td><code>@log.Credential</code></td><td><strong>@log.Method</strong> <code>@log.Path</code></td><td>@log.StatusCode</td><td>@log.DurationMs ms</td><td>@if (log.VideoId is Guid videoId) { <a href="/admin/system/videos/@videoId">@videoId.ToString()[..8]</a><br/> }<code>@log.TraceId</code></td></tr> }</tbody></table></div></section>
</div>
