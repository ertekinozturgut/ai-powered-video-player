@inject VideoAtlas.Application.ILocalizationAdministration Catalog
@{ var homeOwner = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; var homeLanguage = await Catalog.ResolveLanguageAsync(homeOwner, Context.Request.Cookies["VideoAtlas.Language"], Context.RequestAborted); var t = new Dictionary<string, string>(); foreach (var key in new[] { "home.workspace", "home.library", "home.private", "home.eyebrow", "home.title", "home.description", "home.myVideos", "home.search", "home.loading", "home.emptyTitle", "home.emptyDescription", "home.firstUpload", "home.previous", "home.next", "upload.title" }) t[key] = await Catalog.TextAsync(key, homeLanguage, Context.RequestAborted); ViewData["Title"] = t["home.title"]; }
<header class="topbar"><span>@t["home.workspace"] <span class="slash">/</span> <strong>@t["home.library"]</strong></span><span class="security-pill">◇ @t["home.private"]</span></header>
<div class="workspace-content">
    <div class="page-heading"><div><span class="eyebrow">@t["home.eyebrow"]</span><h1>@t["home.title"]<span class="accent-dot">.</span></h1><p class="muted">@t["home.description"]</p></div><button class="btn btn-primary" data-open="upload-dialog">＋ @t["upload.title"]</button></div>
    @if (ViewBag.SpeechConfigured != true || ViewBag.AiConfigured != true) { <div class="notice"><span>◇</span><div><strong>Sağlayıcı durumu</strong><p>STT: @(ViewBag.SpeechConfigured == true ? "yapılandırıldı" : "devre dışı; SRT içe aktarın"). Sohbet: @(ViewBag.AiConfigured == true ? "AI yapılandırıldı" : "alıntı arama modu"). Aktif sağlayıcıları yönetici panelinden seçebilirsiniz.</p></div></div> }
    <section class="intro-banner"><div class="banner-copy"><span class="eyebrow">HER ANIN BİR CEVABI VAR</span><h2>Sadece izlemeyin.<br /><span>Videonuzla konuşun.</span></h2><p>Bir soru sorun. Doğru anı bulun.<br />Konuşmaları, kaynağı belli cevaplara dönüştürün.</p><div class="feature-pills"><span>◷ Zaman kodlu metin</span><span>▤ Konu başlıkları</span><span>✦ Kaynaklı sohbet</span></div></div><div class="banner-art" aria-hidden="true"><div class="banner-orbit"></div><img src="/images/atlas-orb.svg" alt="" width="260" height="260" /><span class="orb-caption"><i></i> Yeni bir bakış açısı</span></div></section>
    <div class="library-toolbar"><h2>@t["home.myVideos"] <span id="video-count" class="count-badge">0</span></h2><label class="search-box"><span aria-hidden="true">⌕</span><input id="library-search" type="search" placeholder="@t["home.search"]" aria-label="@t["home.search"]" /></label></div>
    <div id="library-loading" class="empty-state"><span class="spinner-border" aria-hidden="true"></span><p>@t["home.loading"]</p></div>
    <div id="library-error" class="notice error" role="alert" hidden></div>
    <div id="library-grid" class="video-grid"></div>
    <div id="library-empty" class="empty-state" hidden><div class="empty-icon">▷</div><h3>@t["home.emptyTitle"]</h3><p>@t["home.emptyDescription"]</p><button class="btn btn-primary" data-open="upload-dialog">@t["home.firstUpload"]</button><small>MP4, MOV veya WebM · 512 MiB / 2 hours</small></div>
    <div class="pagination-controls"><button id="previous-page" class="btn btn-outline-secondary" disabled>@t["home.previous"]</button><span id="page-label">1</span><button id="next-page" class="btn btn-outline-secondary" disabled>@t["home.next"]</button></div>
</div>
<partial name="_UploadDialog" />
@section Scripts { <script type="module" src="/js/library.js" asp-append-version="true"></script> }
