@model PlayerModel
@{ ViewData["Title"] = "Video çalışma alanı"; ViewData["Embedded"] = Model.Embedded; }
<div id="player-app" data-api="@Model.ApiBase" data-embedded="@Model.Embedded.ToString().ToLowerInvariant()">
    @if (!Model.Embedded) { <header class="topbar"><a href="/">← Video kütüphanesi</a><span class="security-pill">◇ Çalışma alanınız</span></header> }
    else { <header class="embed-brand"><span class="brand-mark" aria-hidden="true"></span><strong>VideoAtlas</strong><span>Video ile keşfedin</span></header> }
    <div class="player-heading"><div><span class="eyebrow">VİDEO ÇALIŞMA ALANI</span><h1 id="video-heading">Video yükleniyor…</h1><div class="video-meta"><span id="video-duration">—</span><span id="video-status" class="status-badge">Yükleniyor</span><span id="analysis-label"></span></div></div>
        <div class="heading-actions"><a id="srt-download" class="btn btn-outline-secondary disabled" aria-disabled="true">↓ SRT indir</a>@if (!Model.Embedded) { <button id="share-open" class="btn btn-primary" disabled><span class="arrow-out" aria-hidden="true"></span> Paylaş ve göm</button> }</div>
    </div>
    <div id="player-error" class="notice error" role="alert" hidden></div>
    <div id="processing-notice" class="notice processing" hidden><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><div><strong id="processing-stage"></strong><progress id="processing-progress" max="100" value="0" aria-label="Analiz ilerlemesi"></progress></div></div>
    <div class="player-grid">
        <section class="video-column" aria-label="Video ve konuşmalar">
            <div class="video-frame"><video id="video" controls playsinline preload="metadata" aria-label="Video oynatıcı"></video><div id="video-placeholder" class="video-placeholder"><span>▷</span><p>Video hazırlanıyor</p></div></div>
            <div class="video-foot"><span>◷ <span id="current-time">00:00</span> <span class="muted">/</span> <span id="total-time">00:00</span></span><span class="muted">Konuşmaya tıklayın, o ana gidin.</span></div>
            <div class="transcript-panel">
                <div class="panel-tabs" role="tablist" aria-label="Video bilgileri"><button id="tab-transcript" role="tab" aria-selected="true" aria-controls="transcript-panel" class="selected">▤ Metin dökümü</button><button id="tab-chapters" role="tab" aria-selected="false" aria-controls="chapters-panel" tabindex="-1">◫ Konu başlıkları</button><span id="segment-count"></span></div>
                <section id="transcript-panel" role="tabpanel" aria-labelledby="tab-transcript"><label class="transcript-search"><span aria-hidden="true">⌕</span><input id="transcript-search" type="search" aria-label="Konuşmalarda ara" placeholder="Konuşmalarda ara…" /></label><div id="transcript-list" class="transcript-list"><p class="panel-empty">Metin dökümü hazır olduğunda burada görünecek.</p></div></section>
                <section id="chapters-panel" role="tabpanel" aria-labelledby="tab-chapters" hidden><label class="category-label" for="category-filter">Kategori</label><select id="category-filter" class="form-select"><option value="">Tüm kategoriler</option></select><div id="chapters-list" class="chapters-list"></div></section>
            </div>
            @if (!Model.Embedded) { <div class="owner-tools"><button id="context-open" class="btn btn-outline-secondary" disabled>Terimler ve yönergeler</button><button id="review-open" class="btn btn-outline-secondary" disabled>Transkript kalite kontrolü</button><label class="btn btn-outline-secondary" for="srt-file">＋ SRT içe aktar</label><input type="file" id="srt-file" accept=".srt" class="visually-hidden" /><button id="retry-video" class="btn btn-outline-secondary" disabled>↻ Yeniden analiz et</button><button id="delete-video" class="btn btn-outline-danger" disabled>Videoyu sil</button></div><partial name="_TranscriptReview" />
                <dialog id="quick-edit-dialog" class="app-dialog compact" aria-labelledby="quick-edit-title">
                    <div class="dialog-heading"><div><span id="quick-edit-kind" class="eyebrow"></span><h2 id="quick-edit-title">Düzenle</h2></div><button type="button" class="icon-button" data-close aria-label="Kapat">×</button></div>
                    <p id="quick-edit-help" class="muted"></p>
                    <form id="quick-edit-form" class="stack-form">
                        <input id="quick-edit-index" type="hidden" />
                        <div id="quick-edit-chapter-fields"><label for="quick-edit-title-input">Başlık</label><input id="quick-edit-title-input" class="form-control" maxlength="240" /><label for="quick-edit-category">Kategori</label><input id="quick-edit-category" class="form-control" maxlength="120" /><label for="quick-edit-summary">Özet</label><textarea id="quick-edit-summary" class="form-control" rows="4" maxlength="4000"></textarea></div>
                        <label for="quick-edit-text">Metin</label><textarea id="quick-edit-text" class="form-control" rows="5" maxlength="16000" required></textarea>
                        <div class="review-actions"><label>Başlangıç (saniye)<input id="quick-edit-start" type="number" min="0" step="0.001" class="form-control" required /></label><label>Bitiş (saniye)<input id="quick-edit-end" type="number" min="0" step="0.001" class="form-control" required /></label></div>
                        <label id="quick-edit-verified-label" class="check-label"><input id="quick-edit-verified" type="checkbox" required /> Sesi dinledim; metnin bu zaman aralığında söylendiğini doğruladım.</label>
                        <div id="quick-edit-error" class="form-error" role="alert"></div><button id="quick-edit-save" class="btn btn-primary" type="submit">Değişikliği kaydet</button>
                    </form>
                </dialog> }
            @if (!Model.Embedded) { <partial name="_Operations" /> }
        </section>
        <aside class="chat-panel" aria-label="Video sohbeti"><div class="chat-heading"><span class="ai-mark">✦</span><div><h2>Videoya sorun</h2><p>Zaman kodlu, kaynağı belli cevaplar</p></div><button id="clear-chat" class="icon-button" aria-label="Sohbeti temizle" title="Sohbeti temizle">↺</button></div>
            <div id="chat-messages" class="chat-messages" role="log" aria-live="polite"><div id="chat-welcome" class="chat-welcome"><img class="welcome-orb" src="/images/atlas-orb.svg" alt="" width="148" height="148" /><span class="eyebrow">MERHABA, MERAK EDEN.</span><h3>Birlikte ne<br />keşfedelim?</h3><p>Videonuzun içindeki cevaplara,<br />kaynağıyla birlikte ulaşın.</p><div class="suggestions"><button data-question="Bu videoda hangi konular ele alınıyor?"><span>Bu videoda neler konuşuluyor?</span><span aria-hidden="true">↗</span></button><button data-question="Öne çıkan kararlar ve yapılacak işler neler?"><span>Kararları ve aksiyonları bul</span><span aria-hidden="true">↗</span></button><button data-question="Videonun ana fikrini özetler misin?"><span>Ana fikri özetle</span><span aria-hidden="true">↗</span></button></div></div></div>
            <div class="chat-actions px-3"><label for="chat-action">Yanıt türü</label><select id="chat-action" class="form-select"><option value="question">Soru cevap</option><option value="summary">Video özeti</option><option value="decisions">Kararlar</option><option value="actions">Yapılacak işler</option><option value="section">Seçili bölümü açıkla</option></select><div id="chat-section" hidden><label for="section-start">Başlangıç (saniye)</label><input id="section-start" type="number" min="0" value="0" class="form-control" /><label for="section-end">Bitiş (saniye)</label><input id="section-end" type="number" min="1" value="30" class="form-control" /></div></div>
            <div id="chat-error" class="form-error px-3" role="alert"></div>
            <form id="chat-form" class="chat-form"><label for="chat-question" class="visually-hidden">Videoyla ilgili sorunuz</label><div class="chat-input"><textarea id="chat-question" maxlength="2000" rows="2" placeholder="Bu video hakkında bir soru sorun…" required disabled></textarea><button id="chat-submit" type="submit" aria-label="Soruyu gönder" disabled>↑</button></div><small id="chat-mode">@(ViewBag.AiConfigured == true ? "AI yanıtlarını kaynak konuşmalarla doğrulayın." : "Alıntı arama modu · AI bağlantısı yapılandırılmamış.")</small><small>Sohbet yalnızca bu sekmede tutulur.</small></form>
        </aside>
    </div>
</div>
@if (!Model.Embedded) { <partial name="_ShareDialog" /><dialog id="delete-dialog" class="app-dialog compact"><h2>Video silinsin mi?</h2><p>Video dosyası, metni, konu başlıkları ve paylaşım bağlantısı kalıcı olarak silinir.</p><div class="dialog-actions"><button data-close class="btn btn-outline-secondary">Vazgeç</button><button id="confirm-delete" class="btn btn-danger">Kalıcı olarak sil</button></div></dialog> }
@section Scripts { <script type="module" src="/js/player.js" asp-append-version="true"></script> }
