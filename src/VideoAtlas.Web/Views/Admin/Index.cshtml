@using VideoAtlas.Application
@model ProviderAdminView
@{ ViewData["Title"] = "AI sağlayıcı yönetimi"; }
<header class="topbar"><span>Yönetim <span class="slash">/</span> <strong>AI sağlayıcıları</strong></span><span class="security-pill">Yalnızca yönetici</span></header>
<div class="workspace-content provider-page">
    <div class="page-heading"><div><span class="eyebrow">KONTROL SİZDE</span><h1>AI sağlayıcıları<span class="accent-dot">.</span></h1><p class="muted">Ses, dil modeli ve indeksleme için bağımsız sağlayıcı seçin.</p></div></div>
    @if (TempData["ProviderMessage"] is string message) { <div class="notice" role="status">@message</div> }
    <div asp-validation-summary="All" class="form-error" role="alert"></div>
    <form action="/admin/providers/select" method="post" class="provider-capability-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Version" value="@Model.Selection.Version" />
        @foreach (var group in new[] {
            (Capability: ProviderCapability.Speech, Field: "Speech", Title: "Konuşmayı metne çevirme", Label: "STT", Icon: "◉", Description: "Video sesini zaman kodlu metne dönüştüren birincil sağlayıcı.", Selected: Model.Selection.Speech),
            (Capability: ProviderCapability.Chat, Field: "Chat", Title: "Dil modeli", Label: "LLM", Icon: "✦", Description: "Sohbet, özet, konu başlıkları ve metin kalite analizlerini üretir.", Selected: Model.Selection.Chat),
            (Capability: ProviderCapability.Embedding, Field: "Embedding", Title: "Anlamsal indeksleme", Label: "INDEX", Icon: "⌘", Description: "Video metnini aranabilir vektör indeksine dönüştürür.", Selected: Model.Selection.Embedding) })
        {
            <section class="provider-capability provider-panel">
                <div class="capability-heading"><span class="capability-icon" aria-hidden="true">@group.Icon</span><div><span class="eyebrow">@group.Label</span><h2>@group.Title</h2><p class="muted">@group.Description</p></div></div>
                <div class="capability-route"><label for="@group.Field">Aktif sağlayıcı</label><select id="@group.Field" name="@group.Field" class="form-select"><option value="">Devre dışı</option>@foreach (var p in Model.Profiles.Where(p => p.Capability == group.Capability)) { var ready = p.HasSecret || p.Kind is "ollama" or "local-whisper"; <option value="@p.Id" selected="@(p.Id == group.Selected)">@p.Name @(!ready ? "· yapılandırma gerekli" : "")</option> }</select></div>
                @if (group.Capability == ProviderCapability.Speech)
                {
                    <div class="secondary-route"><label for="SecondarySpeech">İkinci STT · karşılaştırma</label><select id="SecondarySpeech" name="SecondarySpeech" class="form-select"><option value="">Devre dışı</option>@foreach (var p in Model.Profiles.Where(p => p.Capability == ProviderCapability.Speech)) { var ready = p.HasSecret || p.Kind is "ollama" or "local-whisper"; <option value="@p.Id" selected="@(p.Id == Model.Selection.SecondarySpeech)">@p.Name @(!ready ? "· yapılandırma gerekli" : "")</option> }</select><small class="muted">Birincil STT’den farklı olmalıdır ve yalnızca karşılaştırma istendiğinde çağrılır.</small></div>
                }
                <div class="capability-profiles">
                    @foreach (var profile in Model.Profiles.Where(p => p.Capability == group.Capability))
                    {
                        var ready = profile.HasSecret || profile.Kind is "ollama" or "local-whisper";
                        <article class="provider-option @(profile.Id == group.Selected ? "selected" : "")">
                            <div><strong>@profile.Name</strong><span class="provider-kind">@profile.Kind</span></div>
                            <p>@profile.Model</p>
                            <span class="status-badge @(ready ? "status-ready" : "status-awaitingtranscript")">@(profile.HasSecret ? "Anahtar kayıtlı" : ready ? "Yerel bağlantı hazır" : "Yapılandırma gerekli")</span>
                            <a class="btn btn-outline-secondary" href="/admin/providers/@profile.Id" aria-label="@profile.Name ayarlarını düzenle">@(profile.Kind == "n8n" ? "n8n akışını bağla →" : "Ayarları düzenle →")</a>
                        </article>
                    }
                </div>
            </section>
        }
        <div class="provider-savebar"><div><strong>Yönlendirme seçimini kaydet</strong><span>Yeni işler bu seçimleri kullanır; devam eden işler değişmez.</span></div><button class="btn btn-primary" type="submit">Aktif sağlayıcıları kaydet</button></div>
        <small class="provider-updated muted">Son değişiklik: @Model.Selection.UpdatedAt.ToString("u") · @Model.Selection.UpdatedBy</small>
    </form>
    <div class="notice"><span aria-hidden="true">◇</span><div><strong>Anahtar kayıtlı ≠ bağlantı doğrulandı</strong><p>Kaydedilen sağlayıcılar otomatik olarak ücretli test çağrısı yapmaz. Model erişimi, kota ve ağ izinleri ilk gerçek işlemde doğrulanır. Hata halinde başka sağlayıcıya sessiz geçiş yapılmaz.</p></div></div>
    <section class="provider-panel n8n-kit">
        <div class="section-heading"><div><span class="eyebrow">N8N BAĞLANTI KİTİ</span><h2>Örnek akışlar ve bağlantı sözleşmesi</h2><p class="muted">Her yetenek ayrı production webhook kullanır. JSON’u n8n’e aktarın, işaretli alana kendi AI düğümünüzü bağlayın, Header Auth kimliğini ayarlayın ve akışı yayınlayın.</p></div><span class="status-badge">Sözleşme v1</span></div>
        <div class="n8n-template-grid">
            <article><span class="capability-icon">◉</span><div><strong>STT akışı</strong><p>Multipart ses dosyası alır; zaman kodlu <code>segments</code> döndürür.</p></div><a class="btn btn-outline-secondary" href="/workflows/videoatlas-n8n-stt.json" download>JSON indir</a></article>
            <article><span class="capability-icon">✦</span><div><strong>Dil modeli akışı</strong><p>System ve data alanlarını alır; JSON metnini <code>content</code> içinde döndürür.</p></div><a class="btn btn-outline-secondary" href="/workflows/videoatlas-n8n-chat.json" download>JSON indir</a></article>
            <article><span class="capability-icon">⌘</span><div><strong>Embedding akışı</strong><p>Metin dizisini alır; aynı sırada ve istenen boyutta <code>vectors</code> döndürür.</p></div><a class="btn btn-outline-secondary" href="/workflows/videoatlas-n8n-embedding.json" download>JSON indir</a></article>
        </div>
        <details class="n8n-guide"><summary>n8n bağlantısı nasıl kurulur?</summary><ol><li>İlgili JSON dosyasını n8n’de <strong>Import from File</strong> ile içe aktarın.</li><li>Webhook düğümünde Header Auth kimliği oluşturun: ad <code>Authorization</code>, değer <code>Bearer &lt;güçlü-rastgele-anahtar&gt;</code>.</li><li>Şablondaki “AI sağlayıcınızı buraya bağlayın” düğümünü kendi OpenAI, ElevenLabs veya başka sağlayıcı düğümünüzle değiştirin; dönüşü şablondaki sözleşmeye eşleyin.</li><li>Workflow’u yayınlayın ve production webhook yolunu kopyalayın.</li><li>VideoAtlas’taki ilgili <strong>n8n akışını bağla</strong> ekranına ortam adresini, webhook yolunu, workflow kimliğini ve aynı Bearer anahtarını girin.</li><li>Kaydettikten sonra bu sayfada n8n profilini aktif sağlayıcı seçip yönlendirmeyi kaydedin.</li></ol><p class="muted">Test webhook adresi yerine <code>/webhook/...</code> production adresini kullanın. VideoAtlas yönlendirme takip etmez ve yalnızca HTTPS n8n Cloud ya da sunucuda izin verilen özel hostlara bağlanır.</p></details>
    </section>
</div>
