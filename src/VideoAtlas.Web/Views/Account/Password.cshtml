@model PasswordResetForm
@{ ViewData["Title"] = "Parolamı değiştir"; }
<section class="auth-page">
    <partial name="_AuthStory" />
    <div class="auth-card"><span class="auth-emblem" aria-hidden="true">✦</span><span class="eyebrow">HESAP GÜVENLİĞİ</span><h2>Parolanızı<br />yenileyin.</h2><p class="muted">Yeni parolanız en az 12 karakter; büyük/küçük harf, rakam ve sembol içermelidir.</p>
        @if (TempData["AccountMessage"] is string message) { <p class="notice">@message</p> }
        <form asp-action="Password" method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <div><label asp-for="Email">E-posta adresi</label><input asp-for="Email" class="form-control" readonly /><span asp-validation-for="Email" class="form-error"></span></div>
            <div><label asp-for="NewPassword">Yeni parola</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="form-error"></span></div>
            <div><label asp-for="ConfirmPassword">Yeni parola (tekrar)</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="form-error"></span></div>
            <button class="btn btn-primary btn-lg" type="submit">Parolayı değiştir</button>
        </form><p class="auth-foot"><a href="/">Video kütüphanesine dön</a></p>
    </div>
</section>
