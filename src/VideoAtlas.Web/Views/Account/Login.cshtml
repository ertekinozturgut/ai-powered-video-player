@model AccountForm
@{ ViewData["Title"] = "Giriş yap"; }
<section class="auth-page">
    <partial name="_AuthStory" />
    <div class="auth-card"><span class="auth-emblem" aria-hidden="true">✦</span><span class="eyebrow">TEKRAR MERHABA</span><h2>Kaldığınız yerden<br />keşfetmeye devam edin.</h2><p class="muted">Videolarınız ve fikirleriniz sizi bekliyor.</p>
        <form asp-action="Login" method="post" class="stack-form">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <div><label asp-for="Email">E-posta adresi</label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="form-error"></span></div>
            <div><label asp-for="Password">Parola</label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="form-error"></span><a class="forgot-password-link" href="/account/forgot-password">Şifremi unuttum</a></div>
            <button class="btn btn-primary btn-lg" type="submit">Giriş yap <span aria-hidden="true">→</span></button>
        </form>
        @if (ViewBag.AllowRegistration == true) { <p class="auth-foot">Yeni misiniz? <a href="/account/register">Hesap oluşturun</a></p> }
        else { <p class="auth-foot">Parolanızı değiştirmek için giriş yaptıktan sonra hesap menüsündeki <strong>Parolamı değiştir</strong> bağlantısını kullanın. Giriş yapamıyorsanız çalışma alanı yöneticiniz parolanızı sıfırlayabilir.</p> }
        <a href="/privacy" class="muted small">Gizlilik ve veri işleme</a>
    </div>
</section>
