@model PasswordRecoveryRequestForm
@{ ViewData["Title"] = "Parola sıfırlama"; }
<section class="auth-page">
    <partial name="_AuthStory" />
    <div class="auth-card"><span class="auth-emblem" aria-hidden="true">✦</span><span class="eyebrow">HESAP KURTARMA</span><h2>Parolanızı<br />sıfırlayın.</h2><p class="muted">E-posta adresinizi girin. Hesap güvenliği için kayıt durumunu ekranda paylaşmayız.</p>
        @if (TempData["RecoveryMessage"] is string message) { <p class="notice">@message</p> }
        else { <form asp-action="ForgotPassword" method="post" class="stack-form"><div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div><div><label asp-for="Email">E-posta adresi</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="form-error"></span></div><button class="btn btn-primary btn-lg" type="submit">Sıfırlama talebi oluştur</button></form> }
        <p class="auth-foot"><a href="/account/login">Giriş ekranına dön</a></p>
    </div>
</section>
