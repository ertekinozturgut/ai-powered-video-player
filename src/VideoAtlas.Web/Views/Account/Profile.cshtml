@model AccountPageView
@inject VideoAtlas.Application.ILocalizationAdministration Catalog
@{ var accountLanguage = Model.Profile.Language; var a = new Dictionary<string, string>(); foreach (var key in new[] { "account.title", "account.back", "account.settings", "account.description", "account.profile", "account.displayName", "account.language", "account.email", "account.currentPassword", "account.save", "account.changePassword", "account.newPassword", "account.confirmPassword" }) a[key] = await Catalog.TextAsync(key, accountLanguage, Context.RequestAborted); ViewData["Title"] = a["account.title"]; }
<header class="topbar"><a href="/">@a["account.back"]</a><span class="security-pill">◇ @a["account.settings"]</span></header>
<div class="workspace-content account-page">
  <div class="page-heading"><div><span class="eyebrow">@a["account.title"]</span><h1>@a["account.title"]<span class="accent-dot">.</span></h1><p class="muted">@a["account.description"]</p></div></div>
  @if (TempData["AccountMessage"] is string message) { <div class="notice" role="status">@message</div> }
  <div class="account-settings-grid">
    <section class="provider-panel"><h2>@a["account.profile"]</h2><form asp-action="Profile" method="post" class="stack-form">@Html.AntiForgeryToken()<input asp-for="Profile.Language" type="hidden" /><div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div><div><label asp-for="Profile.DisplayName">@a["account.displayName"]</label><input asp-for="Profile.DisplayName" class="form-control" placeholder="Ad Soyad" /></div><div><label asp-for="Profile.Email">@a["account.email"]</label><input asp-for="Profile.Email" class="form-control" autocomplete="email" placeholder="kullanici@example.test" /></div><div><label asp-for="Profile.CurrentPassword">@a["account.currentPassword"]</label><input asp-for="Profile.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="••••••••••••" /><span asp-validation-for="Profile.CurrentPassword" class="form-error"></span></div><button class="btn btn-primary" type="submit">@a["account.save"]</button></form></section>
    <section class="provider-panel"><h2>@a["account.language"]</h2><p class="muted">Seçiminiz bu tarayıcıya ve hesabınıza kaydedilir.</p><form action="/language/select" method="post" class="language-preference-form" data-language-form>@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="/account/profile" /><label for="account-language">@a["account.language"]</label><div class="language-preference-control"><select id="account-language" name="code" class="form-select" data-language-select>@foreach (var language in Model.Languages) { <option value="@language.Code" selected="@(language.Code == Model.Profile.Language)">@language.Name</option> }</select><button class="btn btn-outline-secondary" type="submit">Dili uygula</button></div></form></section>
    <section class="provider-panel"><h2>@a["account.changePassword"]</h2><form asp-action="Password" method="post" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="Email" value="@Model.Profile.Email" /><div><label for="NewPassword">@a["account.newPassword"]</label><input id="NewPassword" name="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••••••" required /></div><div><label for="ConfirmPassword">@a["account.confirmPassword"]</label><input id="ConfirmPassword" name="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••••••" required /></div><button class="btn btn-outline-secondary" type="submit">@a["account.changePassword"]</button></form></section>
  </div>
</div>
