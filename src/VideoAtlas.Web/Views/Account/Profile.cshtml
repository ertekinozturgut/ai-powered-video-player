@model AccountPageView
@inject VideoAtlas.Application.ILocalizationAdministration Catalog
@{ var accountLanguage = Model.Profile.Language; var a = new Dictionary<string, string>(); foreach (var key in new[] { "account.title", "account.back", "account.settings", "account.description", "account.profile", "account.displayName", "account.language", "account.email", "account.currentPassword", "account.save", "account.changePassword", "account.newPassword", "account.confirmPassword" }) a[key] = await Catalog.TextAsync(key, accountLanguage, Context.RequestAborted); ViewData["Title"] = a["account.title"]; }
<header class="topbar"><a href="/">@a["account.back"]</a><span class="security-pill">◇ @a["account.settings"]</span></header>
<div class="workspace-content account-page">
  <div class="page-heading"><div><span class="eyebrow">@a["account.title"]</span><h1>@a["account.title"]<span class="accent-dot">.</span></h1><p class="muted">@a["account.description"]</p></div></div>
  @if (TempData["AccountMessage"] is string message) { <div class="notice" role="status">@message</div> }
  <div class="account-settings-grid">
    <section class="provider-panel"><h2>@a["account.profile"]</h2><form asp-action="Profile" method="post" class="stack-form">@Html.AntiForgeryToken()<input asp-for="Profile.Language" type="hidden" /><div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div><div><label asp-for="Profile.DisplayName">@a["account.displayName"]</label><input asp-for="Profile.DisplayName" class="form-control" placeholder="Ad Soyad" /></div><div><label asp-for="Profile.Email">@a["account.email"]</label><input asp-for="Profile.Email" class="form-control" autocomplete="email" placeholder="kullanici@example.test" /></div><div><label asp-for="Profile.CurrentPassword">@a["account.currentPassword"]</label><input asp-for="Profile.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="••••••••••••" /><span asp-validation-for="Profile.CurrentPassword" class="form-error"></span></div><button class="btn btn-primary" type="submit">@a["account.save"]</button></form></section>
    <section class="provider-panel"><h2>@a["account.language"]</h2><p class="muted">Seçiminiz bu tarayıcıya ve hesabınıza kaydedilir.</p><form action="/language/select" method="post" class="language-preference-form" data-language-form>@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="/account/profile" /><label for="account-language">@a["account.language"]</label><div class="language-preference-control"><select id="account-language" name="code" class="form-select" data-language-select>@foreach (var language in Model.Languages) { <option value="@language.Code" selected="@(language.Code == Model.Profile.Language)">@language.Name</option> }</select><button class="btn btn-outline-secondary" type="submit">Dili uygula</button></div></form></section>
    <section class="provider-panel"><h2>@a["account.changePassword"]</h2><form asp-action="Password" method="post" class="stack-form">@Html.AntiForgeryToken()<input type="hidden" name="Email" value="@Model.Profile.Email" /><div><label for="NewPassword">@a["account.newPassword"]</label><input id="NewPassword" name="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••••••" required /></div><div><label for="ConfirmPassword">@a["account.confirmPassword"]</label><input id="ConfirmPassword" name="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••••••" required /></div><button class="btn btn-outline-secondary" type="submit">@a["account.changePassword"]</button></form></section>
  </div>
  <section class="provider-panel mt-4">
    <div class="page-heading"><div><span class="eyebrow">THIRD-PARTY API</span><h2>API kimlik bilgileri</h2><p class="muted">Harici sistemlerin bu hesaba bağlı analiz başlatması için kapsamlı ve iptal edilebilir anahtarlar oluşturun.</p></div><a class="btn btn-outline-secondary" href="/api/v1" target="_blank" rel="noopener">API bilgisini görüntüle</a></div>
    @if (!string.IsNullOrWhiteSpace(Model.CreatedApiSecret)) { <div class="notice"><strong>Bu gizli anahtar yalnızca bir kez gösterilir:</strong><br /><code style="overflow-wrap:anywhere">@Model.CreatedApiSecret</code></div> }
    <form action="/account/api-credentials" method="post" class="stack-form">@Html.AntiForgeryToken()
      <div class="admin-filter-form"><div><label for="api-name">Ad</label><input id="api-name" name="Name" class="form-control" value="Integration" maxlength="80" required /></div><div><label for="api-expiry">Geçerlilik</label><select id="api-expiry" name="ExpiresInDays" class="form-select"><option value="30">30 gün</option><option value="90" selected>90 gün</option><option value="365">1 yıl</option><option value="0">Süresiz</option></select></div></div>
      <div class="form-check"><input id="scope-read" name="Read" value="true" type="checkbox" checked /><label for="scope-read">Analizleri oku</label> <input type="hidden" name="Read" value="false" /></div>
      <div class="form-check"><input id="scope-write" name="Write" value="true" type="checkbox" checked /><label for="scope-write">Analiz oluştur / yeniden çalıştır</label> <input type="hidden" name="Write" value="false" /></div>
      <div class="form-check"><input id="scope-delete" name="Delete" value="true" type="checkbox" /><label for="scope-delete">Analiz sil</label> <input type="hidden" name="Delete" value="false" /></div>
      <button class="btn btn-primary" type="submit">API anahtarı oluştur</button>
    </form>
    <div class="table-responsive mt-3"><table class="table"><thead><tr><th>Ad / önek</th><th>Kapsamlar</th><th>Geçerlilik</th><th>Son kullanım</th><th></th></tr></thead><tbody>
    @foreach (var item in Model.ApiCredentials) { <tr><td><strong>@item.Name</strong><br /><code>vat_@item.Prefix.…</code></td><td><small>@item.Scopes</small></td><td>@(item.Revoked ? "İptal edildi" : item.ExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "Süresiz")</td><td>@(item.LastUsedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td><td>@if (!item.Revoked) { <form action="/account/api-credentials/@item.Id/revoke" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" type="submit">İptal et</button></form> }</td></tr> }
    @if (Model.ApiCredentials.Count == 0) { <tr><td colspan="5" class="muted">Henüz API kimlik bilgisi yok.</td></tr> }
    </tbody></table></div>
  </section>
  <section class="provider-panel mt-4"><h2>API üzerinden oluşturulan analizler</h2><p class="muted">Bu kayıtlar aynı kullanıcı kütüphanesine eklenir ve normal video/ses analizleri gibi açılabilir.</p><div class="table-responsive"><table class="table"><thead><tr><th>İçerik</th><th>Durum</th><th>İlerleme</th><th>Oluşturma</th></tr></thead><tbody>@foreach (var item in Model.ApiAnalyses) { <tr><td><a href="/videos/@item.Id">@item.Title</a></td><td>@item.Status · @item.Stage</td><td>%@item.Progress</td><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr> }@if (Model.ApiAnalyses.Count == 0) { <tr><td colspan="4" class="muted">API üzerinden analiz oluşturulmamış.</td></tr> }</tbody></table></div></section>
  <section class="provider-panel mt-4"><h2>API istek kayıtları</h2><p class="muted">İstek gövdeleri ve anahtarlar kaydedilmez; yalnızca güvenli operasyon metadatası listelenir.</p><div class="table-responsive"><table class="table"><thead><tr><th>Zaman</th><th>Anahtar</th><th>İstek</th><th>Sonuç</th><th>Süre</th><th>İz</th></tr></thead><tbody>@foreach (var log in Model.ApiLogs) { <tr><td>@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td><td><code>@log.Credential</code></td><td><strong>@log.Method</strong> <code>@log.Path</code></td><td>@log.StatusCode</td><td>@log.DurationMs ms</td><td><code>@log.TraceId</code></td></tr> }@if (Model.ApiLogs.Count == 0) { <tr><td colspan="6" class="muted">Henüz API isteği yok.</td></tr> }</tbody></table></div></section>
</div>
