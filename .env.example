# Copy to .env on the deployment host; never commit real credentials.
DOMAIN=video.example.com
ACME_EMAIL=operations@example.com
# Legacy OpenAI-compatible provider only. Prefer provider-specific settings below.
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
# Preferred new providers. Supply values securely on your deployment host.
# Admin panel can alternatively store per-profile encrypted secrets.
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
# final = Local Whisper + speaker diarization; runtime-lite = smaller external-provider image.
VIDEOATLAS_DOCKER_TARGET=final
VIDEOATLAS_MEMORY_LIMIT=8g
VIDEOATLAS_CPU_LIMIT=4
# Local HTTP port used only with compose.local.yaml.
VIDEOATLAS_PORT=5080
